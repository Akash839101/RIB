{
  "name": "reachinbox-backend",
  "version": "1.0.0",
  "private": true,
  "description": "ReachInbox email job scheduler backend (Express + BullMQ + Postgres + Redis)",
  "main": "dist/server-entry.js",
  "scripts": {
    "dev": "tsx watch src/server-entry.ts",
    "worker": "tsx watch src/queue/email-worker.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "vercel-build": "prisma generate && prisma migrate deploy && tsc -p tsconfig.json",
    "postinstall": "prisma generate",
    "start": "node dist/server-entry.js",
    "start:worker": "node dist/queue/email-worker.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev",
    "seed": "tsx prisma/seed-database.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed-database.ts"
  },
  "dependencies": {
    "@bull-board/api": "^6.10.1",
    "@bull-board/express": "^6.10.1",
    "@elastic/elasticsearch": "^8.17.0",
    "@prisma/client": "^6.3.1",
    "axios": "^1.7.9",
    "bullmq": "^5.40.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-async-errors": "^3.1.1",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^6.9.16",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.7",
    "@types/nodemailer": "^6.4.17",
    "prisma": "^6.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
